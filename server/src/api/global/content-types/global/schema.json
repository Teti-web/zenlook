{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global",
    "description": "Define global settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos"]
    },
    "siteDescription": {
      "type": "text",
      "required": true
    },
    "defaultSeo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "intro": {
      "type": "component",
      "component": "main.intro",
      "repeatable": false
    },
    "description": {
      "type": "component",
      "component": "molecules.description",
      "repeatable": false
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "atoms.anagraph",
        "main.features",
        "molecules.auto-slider",
        "main.appointment",
        "main.bag-features",
        "main.beauty-manage",
        "main.reviews"
      ]
    }
  }
}
